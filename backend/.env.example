# Alpaca Paper Trading API credentials
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key

# Hedgify API authentication key (use any secret string)
HEDGIFY_API_KEY=your_secret_api_key_here

# Set to false to simulate orders instead of placing real ones
REAL_OPTIONS_ORDERS=true
